{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "cards-query-mfe": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "mfe",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {},
          "configurations": {
            "production": { "target": "cards-query-mfe:esbuild:production" },
            "development": { "target": "cards-query-mfe:esbuild:development", "dev": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": { "target": "cards-query-mfe:serve-original:development", "rebuildDelay": 0, "dev": true, "port": 0 }
        },
        "esbuild": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/cards-query-mfe",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js", "es-module-shims"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [],
            "styles": [],
            "scripts": []
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "cards-query-mfe:esbuild:production" },
            "development": { "buildTarget": "cards-query-mfe:esbuild:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [],
            "styles": []
          }
        }
      }
    }
  }
}
